# Python
__pycache__/
*.py[cod]
.venv/

# Tooling / session state (not part of the skill)
.omx/
.DS_Store

# Generated run artifacts (videos, narration, ideas, storyboards)
.working_dir/
runs/
*.mp4
*.wav

# Downloaded / cached BGM tracks (never commit audio); keep the dir via .gitkeep
references/bgm_cache/*
!references/bgm_cache/.gitkeep

# OAuth tokens / secrets — never commit
token.json
client_secret*.json

# Playwright agent CLI session artifacts (snapshots, console logs)
.playwright-cli/
**/.playwright-cli/
